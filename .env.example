# =============================================================
# AI Chargeback Guardian — Environment Variables
# =============================================================
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.
# =============================================================

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Database ----
# SQLite (default for prototype)
DATABASE_URL=sqlite:///./chargeback_guardian.db

# ---- LLM Configuration ----
# Provider: "openai", "anthropic", or "demo" (fallback, no API key needed)
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=

# ---- Backend Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
